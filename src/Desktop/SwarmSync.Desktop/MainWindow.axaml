<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SwarmSync.Desktop"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SwarmSync.Desktop.MainWindow"
        Title="SwarmSync.Desktop">
    <Grid Margin="20">
        <StackPanel Spacing="10">
            <TextBlock Text="SwarmSync Desktop" FontSize="24" FontWeight="Bold" />
            <TextBlock Name="StatusText" Text="Connecting to daemon..." Foreground="Gray" />
            <TextBlock Name="LocalIpText" Text="" FontSize="12" Foreground="Gray" />
            <ListBox Name="DeviceList" Height="300">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:DeviceItemViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" />
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                            <TextBlock Text="{Binding IpAddress}" Foreground="Gray" />
                            <TextBlock Text=":" Foreground="Gray" />
                            <TextBlock Text="{Binding Port}" Foreground="Gray" />
                            <TextBlock Text="{Binding StatusText}" Foreground="Gray" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Name="RefreshButton" Content="Refresh" HorizontalAlignment="Left" />
        </StackPanel>
    </Grid>
</Window>
