<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AndroidApplication>True</AndroidApplication>
    <AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
    <AndroidPackageFormat>aab</AndroidPackageFormat>
    <AndroidEnableSqldef>True</AndroidEnableSqldef>
    <AndroidLinkMode>None</AndroidLinkMode>
    <AndroidDexTool>d8</AndroidDexTool>
    <AndroidStripILAfterAOT>False</AndroidStripILAfterAOT>
    <AndroidUseAapt2>True</AndroidUseAapt2>
    <AndroidUseLatestPlatformSdk>True</AndroidUseLatestPlatformSdk>
    <AndroidUseIntermediateDesignerFile>True</AndroidUseIntermediateDesignerFile>
    <AndroidGenerateOnePackagePerAbi>False</AndroidGenerateOnePackagePerAbi>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Platforms/Android/Resources/values/strings.xml" />
    <AndroidResource Include="Platforms/Android/Resources/layout/activity_main.axml" />
    <AndroidResource Include="Platforms/Android/Resources/values/themes.xml" />
    <AndroidResource Include="Platforms/Android/Resources/drawable/ic_daemon.xml" />
    <AndroidManifest Include="Properties/AndroidManifest.xml" />
    <ProjectReference Include="..\..\Core\SwarmSync.Core\SwarmSync.Core.csproj" />
  </ItemGroup>
</Project>
